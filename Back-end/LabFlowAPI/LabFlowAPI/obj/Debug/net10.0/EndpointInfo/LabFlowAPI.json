  "components": {
    "schemas": {
      "AlterarPerfilDTO": {
        "required": [
          "perfilAcesso"
        ],
        "type": "object",
        "properties": {
          "perfilAcesso": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ExtracaoCreateDTO": {
        "required": [
          "idDocumento",
          "tecnologia"
        ],
        "type": "object",
        "properties": {
          "idDocumento": {
            "type": "integer",
            "format": "int32"
          },
          "tecnologia": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "textoExtraido": {
            "type": "string",
            "nullable": true
          },
          "dadosEstruturados": { },
          "nivelConfianca": {
            "maximum": 100,
            "minimum": 0,
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginDTO": {
        "required": [
          "email",
          "senha"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "senha": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegistroDTO": {
        "required": [
          "email",
          "nome",
          "senha"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 250,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 250,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "senha": {
            "maxLength": 72,
            "minLength": 8,
            "type": "string"
          },
          "cargo": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ValidacaoDecisaoDTO": {
        "required": [
          "resultado"
        ],
        "type": "object",
        "properties": {
          "resultado": {
            "minLength": 1,
            "type": "string"
          },
          "observacoes": {
            "type": "string",
            "nullable": true
          },
          "dadosCorrigidos": { }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Cole apenas o token retornado por api/Usuario/login.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
