  "paths": {
    "/api/Documento": {
      "post": {
        "tags": [
          "Documento"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "Arquivo"
                ],
                "type": "object",
                "properties": {
                  "Arquivo": {
                    "type": "string",
                    "format": "binary"
                  },
                  "TipoDocumento": {
                    "maxLength": 80,
                    "minLength": 0,
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "Arquivo": {
                  "style": "form"
                },
                "TipoDocumento": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Documento"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "tamanho",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
